# Copy this file to .env.docker and fill in real values for Docker Compose.
# Never commit the real .env.docker file.
# Note: DATABASE_URL and REDIS_URL use Docker Compose SERVICE NAMES (db, redis)
# as hostnames, not localhost - Compose provides internal DNS resolution for these.

DATABASE_URL=postgresql://devport_user:devport_pass@db:5432/devport
JWT_SECRET_KEY=replace_with_output_of__python3_-c_"import secrets; print(secrets.token_hex(32))"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REDIS_URL=redis://redis:6379/0
